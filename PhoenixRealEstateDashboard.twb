      <aliases enabled='yes' />
      <column caption='Age Years' datatype='integer' name='[Age_Years]' role='measure' type='quantitative' />
      <column caption='Price Category' datatype='string' name='[Calculation_0719641600937984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sale_Price] &gt;= 1000000 THEN &quot;Luxury (1M+)&quot;&#13;&#10;ELSEIF [Sale_Price] &gt;= 700000 THEN &quot;Premium (700K-1M)&quot;&#13;&#10;ELSEIF [Sale_Price] &gt;= 500000 THEN &quot;Mid-High (500K-700K)&quot;&#13;&#10;ELSEIF [Sale_Price] &gt;= 350000 THEN &quot;Mid (350K-500K)&quot;&#13;&#10;ELSE &quot;Affordable (Under 350K)&quot;&#13;&#10;END' />
      </column>
      <column caption='Above List Price' datatype='string' name='[Calculation_0719641601015809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sale_Price] &gt;= [List_Price] THEN &quot;At or Above List&quot;&#13;&#10;ELSE &quot;Below List&quot;&#13;&#10;END' />
      </column>
      <column caption='Price per Sqft Tier' datatype='real' datatype-customized='true' name='[Calculation_0719641601196035]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT(IF [Price_per_Sqft] &gt;= 300 THEN &quot;High (300+)&quot;&#13;&#10;ELSEIF [Price_per_Sqft] &gt;= 200 THEN &quot;Mid (200-300)&quot;&#13;&#10;ELSE &quot;Low (Under 200)&quot;&#13;&#10;END)' />
      </column>
